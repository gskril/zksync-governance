{
  "name": "zksync-governance",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "./web",
    "./shared",
    "./indexer"
  ],
  "scripts": {
    "dev:web": "bun --filter=web run dev",
    "dev:indexer": "bun --filter=indexer run dev",
    "postinstall": "bun --filter=shared run build && bun --filter=indexer run build",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "bun-types": "1.2.8",
    "prettier": "^3.7.4"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "overrides": {
    "kysely": "^0.28.17",
    "drizzle-orm": ">=0.45.2",
    "@hono/node-server@1": "1.19.18",
    "follow-redirects": "^1.16.2"
  }
}
